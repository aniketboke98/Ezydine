{
  "name": "ezydine-backend",
  "version": "1.0.0",
  "description": "Backend API for EzyDine Mobile POS & Restaurant Management with PostgreSQL & Razorpay",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "init-db": "tsx src/db/init.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "razorpay": "^2.9.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "prisma": "^6.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
